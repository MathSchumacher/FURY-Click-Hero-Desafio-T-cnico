// FURY · Tech Challenge — schema do banco de dados
//
// Postgres (Neon) + Prisma. Convive com Redis (BullMQ) — não substitui.
// Divisão de trabalho:
//   - Postgres aqui: dados relacionais persistentes (users, tenants, violações)
//   - Redis: fila de jobs ativos + counters/cache
//
// Convenção de IDs: cuid() — opaco, ordenável, sem revelar contagens internas.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ─────────────────────────────────────────────────────────────────
// Auth — users + tenants + memberships
// ─────────────────────────────────────────────────────────────────

model User {
  id            String              @id @default(cuid())
  email         String              @unique
  /* passwordHash é null pra contas criadas via OAuth (sem senha local) */
  passwordHash  String?
  name          String
  /* sub do ID token do Google; presente só pra contas vinculadas via Google sign-in */
  googleId      String?             @unique
  avatarUrl     String?
  emailVerified Boolean             @default(false)
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt
  memberships   Membership[]
  verifications VerificationToken[]

  @@index([createdAt])
}

enum VerificationPurpose {
  EMAIL_VERIFICATION
  PASSWORD_RESET
}

model VerificationToken {
  id        String              @id @default(cuid())
  userId    String
  /* SHA-256 do token raw — nunca armazenamos o token original. Garante
     que vazamento da tabela não compromete reset/verify em andamento. */
  tokenHash String              @unique
  purpose   VerificationPurpose
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime            @default(now())
  user      User                @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, purpose])
  @@index([expiresAt])
}

model Tenant {
  id           String          @id @default(cuid())
  slug         String          @unique // gerado a partir do nome no register
  name         String
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  members      Membership[]
  integrations Integration[]
  violations   Violation[]
  settings     TenantSettings?

  @@index([createdAt])
}

enum Role {
  OWNER
  ADMIN
  MEMBER
}

model Membership {
  userId    String
  tenantId  String
  role      Role     @default(MEMBER)
  joinedAt  DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@id([userId, tenantId])
  @@index([tenantId])
}

// ─────────────────────────────────────────────────────────────────
// Integrações com plataformas de ads (Meta, Google, TikTok)
// MVP: "fake OAuth" persiste o registro real. Trocar por OAuth real no futuro.
// ─────────────────────────────────────────────────────────────────

enum Provider {
  META
  GOOGLE
  TIKTOK
}

enum IntegrationStatus {
  ACTIVE
  PAUSED
  ERROR
}

model Integration {
  id             String            @id @default(cuid())
  tenantId       String
  provider       Provider
  accountLabel   String // "Acme Moda · BM_principal"
  externalAccountId String? // ID na plataforma externa (quando OAuth real for ligado)
  status         IntegrationStatus @default(ACTIVE)
  connectedAt    DateTime          @default(now())
  lastSyncAt     DateTime?
  tenant         Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, provider, accountLabel])
  @@index([tenantId])
}

// ─────────────────────────────────────────────────────────────────
// Violações — fonte de verdade do histórico
// Redis tem o job ativo (efêmero). Esta tabela tem o registro permanente.
// ─────────────────────────────────────────────────────────────────

enum ViolationType {
  PROHIBITED_TERM
  BRAND_VIOLATION
  COMPLIANCE_FAIL
}

enum Severity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum ViolationStatus {
  QUEUED
  ACTIVE
  COMPLETED
  FAILED
}

model Violation {
  id                String          @id @default(cuid())
  tenantId          String
  adId              String
  violationType     ViolationType
  severity          Severity
  detectedAt        DateTime
  jobId             String // referência ao BullMQ — formato tenant__ad
  status            ViolationStatus @default(QUEUED)
  attempts          Int             @default(0)
  upstreamStatus    Int?
  upstreamLatencyMs Int?
  errorMessage      String?
  createdAt         DateTime        @default(now())
  finishedAt        DateTime?
  tenant            Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, jobId])
  @@index([tenantId, createdAt(sort: Desc)])
  @@index([severity, status])
  @@index([status])
}

// ─────────────────────────────────────────────────────────────────
// Settings por tenant — controla auto-takedown e thresholds
// ─────────────────────────────────────────────────────────────────

model TenantSettings {
  tenantId      String   @id
  autoTakedown  Boolean  @default(true)
  notifyEmail   Boolean  @default(true)
  thresholdHigh Int      @default(3) // takedown após N violações HIGH no mesmo ad
  updatedAt     DateTime @updatedAt
  tenant        Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

// ─────────────────────────────────────────────────────────────────
// Audit log — ações sensíveis registradas pra compliance + forense.
// Append-only por design; sem update/delete em prod (políticas via DB).
// ─────────────────────────────────────────────────────────────────

enum AuditAction {
  USER_REGISTER
  USER_LOGIN_SUCCESS
  USER_LOGIN_FAIL
  USER_LOGOUT
  USER_PASSWORD_CHANGE
  USER_PASSWORD_RESET_REQUEST
  USER_PASSWORD_RESET_COMPLETE
  USER_EMAIL_VERIFY_REQUEST
  USER_EMAIL_VERIFY_COMPLETE
  USER_GOOGLE_LINK
  USER_GOOGLE_SIGNUP
  TENANT_CREATE
  TENANT_SETTINGS_UPDATE
  MEMBERSHIP_INVITE
  MEMBERSHIP_REMOVE
  MEMBERSHIP_ROLE_CHANGE
  INTEGRATION_CONNECT
  INTEGRATION_DISCONNECT
  WEBHOOK_SECRET_ROTATE
}

model AuditEvent {
  id        String      @id @default(cuid())
  action    AuditAction
  userId    String? // null quando ação anônima (login fail, register attempt)
  tenantId  String? // escopado quando aplicável
  /* contexto adicional: { targetUserId, oldRole, newRole, email, ... }
     NUNCA gravar password/token raw aqui; só metadados não-sensíveis. */
  metadata  Json?
  ipAddress String?
  userAgent String?
  createdAt DateTime    @default(now())

  @@index([userId, createdAt(sort: Desc)])
  @@index([tenantId, createdAt(sort: Desc)])
  @@index([action, createdAt(sort: Desc)])
}
