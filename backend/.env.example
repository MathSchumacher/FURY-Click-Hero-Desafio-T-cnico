PORT=3001
NODE_ENV=development

# === Redis ===
# Opção A: Local via Docker (`npm run redis:up`)
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

# Opção B: Upstash (free tier) — use REDIS_URL e comente REDIS_HOST/PORT/PASSWORD acima.
# Pegue a URL em Upstash → Details → Connect → "redis-cli" e troque o scheme pra rediss:// (TLS).
# REDIS_URL=rediss://default:<token>@<endpoint>.upstash.io:6379

QUEUE_NAME=ad-processing
WORKER_CONCURRENCY=5

# === Upstream takedown ===
# O desafio aponta pra JSONPlaceholder. Troque pra outra URL pra simular comportamentos
# (ex: https://httpstat.us/503 retorna sempre 503, ótimo pra testar retry).
UPSTREAM_URL=https://jsonplaceholder.typicode.com/posts/1
UPSTREAM_TIMEOUT_MS=5000

# === Auth (opcional · só se quiser PASETO persistente entre restarts) ===
# Sem isso, o backend gera um keypair Ed25519 efêmero a cada boot (dev mode).
# Pra produção, gere com:
#   node -e "const {generateKeyPairSync} = require('crypto'); const {privateKey, publicKey} = generateKeyPairSync('ed25519'); console.log(privateKey.export({type:'pkcs8',format:'pem'})); console.log(publicKey.export({type:'spki',format:'pem'}));"
# PASETO_V4_SECRET_KEY_PEM=
# PASETO_V4_PUBLIC_KEY_PEM=
